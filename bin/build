#!/usr/bin/env bash
# Build the PHP image this machine runs: deployme-php:local in development mode
# (the runtime; the code is mounted), deployme-php:prod in production mode
# (bin/configure --mode prod: the `app` target, with the code, its --no-dev
# dependencies and the built assets inside, so a code change needs this again).
#
# The heavy base (core/local/php/Dockerfile.base: PHP extensions compiled in,
# ssh, git, supervisor) comes ready-made from Docker Hub for amd64 and arm64,
# so a build only adds this checkout's config files and this machine's user,
# in seconds. When the base can't be pulled (offline, or not published yet),
# or ./.env asks for it (bin/configure --build-from-source), it's compiled
# here instead, which takes a minute on a fast Mac and several elsewhere.
#
#   bin/build                 (or: make build)
#   bin/build --from-source   compile the base here this once
set -euo pipefail
. "$(dirname "$0")/lib.sh"
cd "$DEPLOYME_ROOT"

local_base=deployme-php-base:local
base=$(deployme_env DEPLOYME_PHP_BASE)
base=${base:-romanovich0195/deployme-php:1}
[ "${1:-}" = --from-source ] && base=$local_base

if [ "$base" != "$local_base" ]; then
    deployme_say "Pulling the PHP base image ($base)"
    if ! docker pull -q "$base" >/dev/null; then
        deployme_warn "Couldn't pull $base, so it's built here from core/local/php/Dockerfile.base instead"
        base=$local_base
    fi
fi

if [ "$base" = "$local_base" ]; then
    deployme_say "Compiling the PHP base image (a few minutes the first time)"
    docker build -f core/local/php/Dockerfile.base -t "$local_base" .
fi

# compose.prod.yml (in COMPOSE_FILE in production mode) picks the target and tag.
if [ "$(deployme_env DEPLOYME_MODE)" = prod ]; then
    deployme_say "Building deployme-php:prod on $base (the app, its dependencies and assets)"
else
    deployme_say "Building deployme-php:local on $base"
fi
DEPLOYME_PHP_BASE=$base deployme_compose build
