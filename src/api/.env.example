APP_NAME=deploy.me
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://deployme.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shared Postgres from ~/Personal/infra, over proxy-network.
# `make db-create` creates the role and fills in DB_PASSWORD.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=deployme
DB_USERNAME=deployme
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Shared Valkey (aliased redis). DB 6/7 and the prefix keep deploy.me's keys
# apart from the other projects on the same server.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=6
REDIS_CACHE_DB=7
REDIS_PREFIX=deployme_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="deploy@deployme.localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb runs in deployme-reverb. PHP publishes to it directly; browsers reach
# it through the edge at wss://deployme.localhost/app/<key>.
# `php artisan deployme:setup` fills in the id, key and secret.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=deployme-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false
REVERB_MAX_REQUEST_SIZE=262144
REVERB_ALLOWED_ORIGINS=deployme.localhost

VITE_APP_NAME="${APP_NAME}"
